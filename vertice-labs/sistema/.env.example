# Copie para .env NA RAIZ do sistema (vertice-labs/sistema/.env) para rodar local com `netlify dev`.
# Em produção, configure as mesmas variáveis no painel do Netlify (Site settings → Environment variables).

# Token do GitHub com acesso ao repositório de dados, permissão "Contents: Read and write".
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx

# Repositório privado que guarda os contratos (1 JSON por contrato em contratos/)
GITHUB_DATA_REPO=victorvianaverbo/vertice-contratos-data
GITHUB_BRANCH=main

# Senha do painel administrativo (use uma senha longa)
ADMIN_PASSWORD=troque-esta-senha

# E-mail que recebe as notificações de assinatura (ativar no FormSubmit no 1º envio)
EMAIL_ASSINATURA=vianavictorv@gmail.com
